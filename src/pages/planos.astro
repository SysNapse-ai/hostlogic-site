---
import BaseLayout from '../layouts/BaseLayout.astro';
import PilotProgramForm from '../components/PilotProgramForm.astro';
import { APP_URL } from '../consts';

const description =
  'Programa piloto HostLogic: trinta dias de graça, começa com 1 imóvel, e depois a mensalidade segue a tabela — 50% por 6 meses para quem participa das conversas. Recomendado para quem tem mais de 5 imóveis; quem tem menos também pode participar.';

const painPoints = [
  'Reservas espalhadas entre e-mail, conversas e planilha.',
  'Hóspede chega sem dados completos ou documentos em dia.',
  'Alterações e cancelamentos sem rastreio claro.',
  'Retrabalho para reunir informações da estadia antes da chegada.',
];

const flowSteps = [
  { title: 'Reserva entra', body: 'A reserva aparece organizada no painel, com datas, hóspedes e status.' },
  {
    title: 'Hóspede preenche',
    body: 'Check-in digital com link seguro: dados, acompanhantes e documentos quando necessário.',
  },
  {
    title: 'Você acompanha',
    body: 'Timeline por reserva: o que está pronto, pendente, alterado ou cancelado.',
  },
  {
    title: 'Operação segue',
    body: 'Informações reunidas para a chegada e os próximos passos da estadia.',
  },
];

const differentiators = [
  'Portal do hóspede pensado para check-in real, não só formulário solto.',
  'Anfitri-IA como apoio operacional: pendências, próximos check-ins e o que exige atenção.',
  'Avisos no iPhone e no Android: reserva, portal, Anfitri-IA e faxina — sem ficar no painel.',
  'Visão por imóvel e por reserva, útil para quem administra várias unidades.',
  'Começa com 1 imóvel. A mensalidade depois segue a tabela, por faixa de imóveis ativos.',
];

const pilotBullets = [
  'Trinta dias de graça, sem cartão.',
  'Começa com 1 imóvel.',
  'Depois dos 30 dias, 50% da mensalidade da tabela por 6 meses, se participar das conversas dos dias 7, 21 e 30.',
  'Sem contrato. Sai quando quiser.',
  'Recomendado para quem tem mais de 5 imóveis. Quem tem menos também pode participar e ajudar.',
];

const pricingTiers = [
  { range: '1 imóvel', price: 'R$39/mês' },
  { range: '2 imóveis', price: 'R$69/mês' },
  { range: '3 a 5 imóveis', price: 'R$99/mês' },
  { range: '6 a 8 imóveis', price: 'R$159/mês' },
  { range: '9 a 15 imóveis', price: 'R$249/mês' },
  { range: 'Mais de 15 imóveis', price: 'Fale com a gente' },
];

const limitsIncluded = [
  'Reservas organizadas no painel.',
  'Portal do hóspede e check-in digital.',
  'Coleta de dados, documentos e status por reserva.',
  'Apoio da Anfitri-IA na operação do dia a dia.',
  'Avisos no iPhone e no Android (reserva, portal, Anfitri-IA e faxina).',
];

const limitsDeferred = [
  'WhatsApp como canal principal do hóspede.',
  'Envio automático à portaria do condomínio — combinado prédio a prédio.',
];

const faq = [
  {
    question: 'Preciso instalar ou configurar algo na Airbnb?',
    answer:
      'Não. Você só informa o endereço do calendário do seu anúncio (a Airbnb fornece) e as reservas passam a entrar sozinhas no HostLogic.',
  },
  {
    question: 'Funciona em condomínio?',
    answer:
      'O app padrão organiza check-in, dados dos hóspedes e status da estadia. Envio automático ao aplicativo da portaria é um módulo à parte, combinado prédio a prédio — não faz parte do produto padrão.',
  },
  {
    question: 'Funciona no iPhone e no Android?',
    answer:
      'Sim. O HostLogic manda avisos no celular: reserva nova, alteração, cancelamento, cadastro no portal, pergunta na Anfitri-IA e faxina iniciada. Ative os avisos uma vez nas configurações. Não é um app da loja — é o HostLogic no celular.',
  },
  {
    question: 'Como funciona o preço por imóvel?',
    answer:
      'Depois dos 30 dias de graça, a mensalidade segue a tabela, a partir de R$39/mês. Quem participa das conversas dos dias 7, 21 e 30 paga 50% dessa mensalidade por 6 meses.',
  },
  {
    question: 'Como começo?',
    answer:
      'Peça para entrar no programa piloto. Recomendamos para quem tem mais de 5 imóveis, e quem tem menos também pode participar. Respondemos por e-mail. Sem cartão e sem contrato.',
  },
];
---

<BaseLayout title="Planos e programa piloto" description={description}>
  <section class="hero hero--compact">
    <div class="container page-head">
      <span class="badge">HostLogic para anfitriões</span>
      <h1>Operação de hospedagem sem planilha espalhada.</h1>
      <p class="lead">
        Reservas, check-in digital, dados dos hóspedes e pendências em um fluxo simples
        para anfitriões de curta temporada.
      </p>
      <p class="sub">
        O HostLogic organiza a operação: reservas, check-in digital, dados dos hóspedes, pendências
        e status — tudo em um só lugar.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#programa-piloto">Quero ser piloto</a>
        <a class="btn btn-ghost" href={APP_URL}>Acessar o sistema</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container commercial-grid">
      <article class="card commercial-card">
        <span class="value-band__eyebrow">Diagnóstico</span>
        <h2>O que mais pesa hoje</h2>
        <ul class="portal-steps">
          {painPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </article>

      <article class="card commercial-card commercial-card--wide">
        <span class="value-band__eyebrow">Fluxo HostLogic</span>
        <h2>Como funciona na prática</h2>
        <div class="commercial-flow-grid">
          {flowSteps.map((step, index) => (
            <div class="commercial-flow-step">
              <span class="commercial-flow-step__num">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="block value-band">
    <div class="container">
      <span class="value-band__eyebrow">Diferencial</span>
      <h2 class="value-band__title">Por que não é só mais uma planilha</h2>
      <div class="commercial-pill-grid">
        {differentiators.map((item) => (
          <div class="commercial-pill">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container commercial-grid">
      <article class="card commercial-card commercial-card--pilot">
        <span class="value-band__eyebrow">Programa piloto</span>
        <h2>Quer ser piloto e receber vantagens?</h2>
        <ul class="portal-steps">
          {pilotBullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
        <p class="portal-note commercial-pilot-cta">
          Mais de 5 imóveis é o perfil que mais aproveita. Com menos, o pedido também é bem-vindo.
        </p>
      </article>

      <article class="card commercial-card">
        <h2>O que vendemos agora</h2>
        <ul class="portal-steps">
          {limitsIncluded.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="card commercial-card">
        <h2>O que avaliamos com calma</h2>
        <ul class="portal-steps">
          {limitsDeferred.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="card commercial-card commercial-card--wide">
        <span class="value-band__eyebrow">Depois dos 30 dias</span>
        <h2>Mensalidade por faixa de imóveis</h2>
        <table class="commercial-pricing-table">
          <caption class="sr-only">Mensalidade por faixa de imóveis ativos</caption>
          <thead>
            <tr>
              <th scope="col">Imóveis ativos</th>
              <th scope="col">Mensalidade</th>
            </tr>
          </thead>
          <tbody>
            {pricingTiers.map((tier) => (
              <tr>
                <td>{tier.range}</td>
                <td>{tier.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="portal-note">
          Depois dos 30 dias, a mensalidade segue esta tabela. Quem participa das conversas dos dias 7, 21 e 30
          paga 50% por 6 meses.
        </p>
      </article>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <h2>Perguntas frequentes</h2>
      <div class="commercial-faq-grid">
        {faq.map((item) => (
          <article class="card commercial-faq-card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
      <p class="portal-note">
        Valores em BRL. Condições promocionais de lançamento — sujeitas a ajuste antes da disponibilidade
        pública. Não substituem proposta ou contrato formal.
      </p>
    </div>
  </section>

  <PilotProgramForm />
</BaseLayout>

<style>
  .hero--compact {
    padding-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    padding-bottom: 0;
  }

  .commercial-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .commercial-grid {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .commercial-card--wide {
      grid-column: 1 / -1;
    }

    .commercial-card--pilot {
      grid-row: span 2;
    }
  }

  .commercial-card {
    height: 100%;
  }

  .commercial-flow-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  @media (min-width: 700px) {
    .commercial-flow-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .commercial-flow-step {
    border: 1px solid var(--hl-border);
    border-radius: var(--hl-radius);
    background: var(--hl-surface-2);
    padding: 1rem 1.1rem;
  }

  .commercial-flow-step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--hl-primary);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
  }

  .commercial-flow-step h3 {
    margin: 0.75rem 0 0.35rem;
    font-size: var(--fs-h3);
  }

  .commercial-flow-step p {
    margin: 0;
    color: var(--hl-text-muted);
    font-size: var(--fs-sm);
  }

  .commercial-pill-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 700px) {
    .commercial-pill-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .commercial-pill {
    border-radius: var(--hl-radius);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(0, 108, 228, 0.12);
    padding: 1rem 1.1rem;
    color: var(--hl-text);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
  }

  .commercial-pilot-cta {
    margin-top: 1rem;
    font-weight: var(--fw-bold);
    color: var(--hl-text-strong);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .commercial-pricing-table {
    width: 100%;
    margin-top: 1rem;
    border-collapse: collapse;
  }

  .commercial-pricing-table th,
  .commercial-pricing-table td {
    padding: 0.7rem 0.85rem;
    text-align: left;
    border-bottom: 1px solid var(--hl-border);
    font-size: var(--fs-sm);
  }

  .commercial-pricing-table th {
    color: var(--hl-text-muted);
    font-weight: var(--fw-bold);
  }

  .commercial-pricing-table td:last-child,
  .commercial-pricing-table th:last-child {
    text-align: right;
    font-weight: var(--fw-bold);
    white-space: nowrap;
  }

  .commercial-pricing-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .commercial-faq-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 800px) {
    .commercial-faq-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .commercial-faq-card h3 {
    margin-top: 0;
    font-size: var(--fs-h3);
  }

  .commercial-faq-card p {
    margin-bottom: 0;
    color: var(--hl-text-muted);
    font-size: var(--fs-sm);
  }
</style>
