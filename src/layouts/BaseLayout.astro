---
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import { SITE, NAV, APP_URL, LEGAL, CONTACT } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const pageDesc = description ?? SITE.description;
const ogImage = new URL('/assets/HostLogic_AppIcon_256.png', SITE.url).href;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${CONTACT.whatsappE164}?text=${encodeURIComponent(CONTACT.whatsappPrefill)}`;

const logoUrl = `${SITE.url}/assets/HostLogic_AppIcon_1024.png`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: CONTACT.email,
      logo: logoUrl,
      description: SITE.description,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      inLanguage: 'pt-BR',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: SITE.url,
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#organization` },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/HostLogic_AppIcon_512.png" />
    <link rel="apple-touch-icon" href="/assets/HostLogic_AppIcon_512.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="256" />
    <meta property="og:image:height" content="256" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="logo-link" aria-label="HostLogic — início">
          <img
            class="logo-horizontal"
            src="/assets/Logo_HostLogic_Horizontal_Transparent.png?v=2"
            alt="HostLogic"
            width="1194"
            height="344"
            decoding="async"
          />
        </a>
        <nav class="site-nav" id="site-nav" aria-label="Navegação principal">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Abrir menu"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
      <div class="container header-action-row">
        <a class="btn btn-primary header-system-link" href={APP_URL}>Acessar o sistema</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container bar">
        <span>&copy; {year} HostLogic — {SITE.tagline}</span>
        <span>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          &nbsp;·&nbsp;
          <a href={LEGAL.privacy}>Privacidade</a>
          &nbsp;·&nbsp;
          <a href={LEGAL.terms}>Termos</a>
        </span>
      </div>
    </footer>

    <a
      class="wa-float"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${CONTACT.whatsappPrompt}. Abrir WhatsApp para falar com a HostLogic, ${CONTACT.phoneDisplay}.`}
    >
      <span class="wa-float__bubble">{CONTACT.whatsappPrompt}</span>
      <span class="wa-float__btn" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path
            fill="currentColor"
            d="M20.52 3.48A11.8 11.8 0 0 0 12.06 0C5.5 0 .16 5.33.16 11.89c0 2.1.55 4.14 1.6 5.95L0 24l6.3-1.65a11.86 11.86 0 0 0 5.76 1.47h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.16-3.45-8.44zM12.07 21.3h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.74.98 1-3.64-.23-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 7c0 5.45-4.44 9.86-9.93 9.86zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"
          ></path>
        </svg>
      </span>
    </a>

    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        const toggle = document.querySelector('.nav-toggle');
        const nav = document.getElementById('site-nav');
        if (!header || !toggle || !nav) return;
        const setOpen = (open) => {
          header.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
        };
        toggle.addEventListener('click', () => {
          setOpen(!header.classList.contains('is-open'));
        });
        // Fecha ao clicar num link
        nav.addEventListener('click', (e) => {
          if (e.target && e.target.tagName === 'A') setOpen(false);
        });
        // Fecha com Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
        // Reset ao voltar para desktop
        window.addEventListener('resize', () => {
          if (window.innerWidth > 820) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
