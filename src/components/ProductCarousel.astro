---
import { PRODUCT_SCREENS } from '../data/product-screens';

const SLIDE_COUNT = PRODUCT_SCREENS.length;
const AUTOPLAY_MS = 7000;
---

<div
  class="pc"
  data-product-carousel
  data-autoplay-ms={String(AUTOPLAY_MS)}
  tabindex="0"
  role="region"
  aria-roledescription="carousel"
  aria-label="Telas reais do HostLogic"
>
  <div class="pc__track" data-pc-track>
    {
      PRODUCT_SCREENS.map((screen, index) => (
        <article
          class="pc__slide"
          data-pc-slide
          aria-roledescription="slide"
          aria-label={`${index + 1} de ${SLIDE_COUNT}: ${screen.title}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="pc__shot">
            <img
              src={screen.image}
              alt={screen.alt}
              width={screen.width}
              height={screen.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </div>
          <div class="pc__copy">
            <span class="pc__area">{screen.area}</span>
            <h3 class="pc__title">{screen.title}</h3>
            <ul class="pc__bullets">
              {screen.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>

  <div class="pc__nav">
    <button type="button" class="pc__arrow" data-pc-prev aria-label="Slide anterior">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M15.4 4.3a1 1 0 0 1 .1 1.4L10.8 12l4.7 6.3a1 1 0 1 1-1.6 1.2l-5.2-7a1 1 0 0 1 0-1.2l5.2-7a1 1 0 0 1 1.5-.05z"
        />
      </svg>
    </button>
    <div class="pc__dots" data-pc-dots>
      {
        PRODUCT_SCREENS.map((screen, index) => (
          <button
            type="button"
            class:list={['pc__dot', { 'is-active': index === 0 }]}
            data-pc-dot
            data-index={String(index)}
            aria-label={`Ir para o slide ${index + 1}: ${screen.title}`}
            aria-current={index === 0 ? 'true' : undefined}
          />
        ))
      }
    </div>
    <button type="button" class="pc__arrow" data-pc-next aria-label="Próximo slide">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M8.6 19.7a1 1 0 0 1-.1-1.4L13.2 12 8.5 5.7a1 1 0 1 1 1.6-1.2l5.2 7a1 1 0 0 1 0 1.2l-5.2 7a1 1 0 0 1-1.5.05z"
        />
      </svg>
    </button>
  </div>

  <p class="pc__status" data-pc-status aria-live="polite">
    {PRODUCT_SCREENS[0].title} (1 de {SLIDE_COUNT})
  </p>
</div>

<script>
  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initCarousel(root: HTMLElement): void {
    const track = root.querySelector<HTMLElement>('[data-pc-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-pc-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pc-dot]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-pc-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-pc-next]');
    const status = root.querySelector<HTMLElement>('[data-pc-status]');
    if (!track || slides.length === 0) return;

    const autoplayMs = Number(root.dataset.autoplayMs || '7000');
    let index = 0;
    let paused = false;
    let timer: ReturnType<typeof setInterval> | null = null;
    let scrollRaf = 0;
    let ignoreScroll = false;
    let navGen = 0;
    let settleTimer: ReturnType<typeof setTimeout> | null = null;

    function slideScrollLeft(slide: HTMLElement): number {
      return (
        slide.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft
      );
    }

    function syncUi(next: number): void {
      index = next;
      slides.forEach((slide, i) => {
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (status) {
        const title = slides[index]?.querySelector('.pc__title')?.textContent?.trim() ?? '';
        status.textContent = `${title} (${index + 1} de ${slides.length})`;
      }
    }

    function markProgrammatic(): void {
      ignoreScroll = true;
      const gen = ++navGen;
      if (settleTimer !== null) clearTimeout(settleTimer);
      const clearIfCurrent = () => {
        if (gen !== navGen) return;
        ignoreScroll = false;
        settleTimer = null;
      };
      let lastLeft = track.scrollLeft;
      let idleFrames = 0;
      const watchIdle = () => {
        if (gen !== navGen) return;
        if (track.scrollLeft === lastLeft) {
          idleFrames += 1;
          if (idleFrames >= 4) {
            clearIfCurrent();
            return;
          }
        } else {
          idleFrames = 0;
          lastLeft = track.scrollLeft;
        }
        requestAnimationFrame(watchIdle);
      };
      requestAnimationFrame(watchIdle);
      track.addEventListener('scrollend', clearIfCurrent, { once: true });
      settleTimer = setTimeout(clearIfCurrent, 1200);
    }

    function goTo(next: number): void {
      const wrapped = (next + slides.length) % slides.length;
      const last = slides.length - 1;
      const wrapping = (index === last && wrapped === 0) || (index === 0 && wrapped === last);
      const adjacent = Math.abs(wrapped - index) === 1;
      const behavior: ScrollBehavior =
        wrapping || !adjacent || prefersReducedMotion() ? 'auto' : 'smooth';
      markProgrammatic();
      track.scrollTo({
        left: slideScrollLeft(slides[wrapped]),
        behavior,
      });
      syncUi(wrapped);
    }

    function indexFromScroll(): number {
      const x = track.scrollLeft;
      let best = 0;
      let bestDist = Infinity;
      slides.forEach((slide, i) => {
        const dist = Math.abs(slideScrollLeft(slide) - x);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      return best;
    }

    function stopAutoplay(): void {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    function startAutoplay(): void {
      stopAutoplay();
      if (prefersReducedMotion() || paused) return;
      timer = setInterval(() => {
        if (paused || document.hidden || prefersReducedMotion()) return;
        goTo(index + 1);
      }, autoplayMs);
    }

    prevBtn?.addEventListener('click', () => goTo(index - 1));
    nextBtn?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const i = Number(dot.dataset.index);
        if (Number.isFinite(i)) goTo(i);
      });
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      }
    });

    track.addEventListener(
      'scroll',
      () => {
        if (ignoreScroll) return;
        cancelAnimationFrame(scrollRaf);
        scrollRaf = requestAnimationFrame(() => {
          if (ignoreScroll) return;
          const fromScroll = indexFromScroll();
          if (fromScroll !== index) syncUi(fromScroll);
        });
      },
      { passive: true },
    );

    let hoverPaused = false;
    let focusPaused = false;

    const applyPauseState = () => {
      paused = hoverPaused || focusPaused;
      if (paused) stopAutoplay();
      else startAutoplay();
    };

    root.addEventListener('mouseenter', () => {
      hoverPaused = true;
      applyPauseState();
    });
    root.addEventListener('mouseleave', () => {
      hoverPaused = false;
      applyPauseState();
    });
    root.addEventListener('focusin', () => {
      focusPaused = true;
      applyPauseState();
    });
    root.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (next instanceof Node && root.contains(next)) return;
      focusPaused = false;
      applyPauseState();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });

    startAutoplay();
  }

  document.querySelectorAll<HTMLElement>('[data-product-carousel]').forEach(initCarousel);
</script>

<style>
  .pc {
    --pc-radius: 12px;
    --pc-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    position: relative;
    margin-top: var(--space-block);
    outline: none;
  }
  .pc:focus-visible {
    outline: 2px solid var(--hl-primary-soft);
    outline-offset: 6px;
    border-radius: var(--pc-radius);
  }

  .pc__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .pc__track::-webkit-scrollbar {
    display: none;
  }

  .pc__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: grid;
    gap: 1.5rem;
    align-items: center;
    min-width: 0;
  }

  .pc__shot {
    width: min(100%, 18.5rem);
    margin: 0 auto;
    border-radius: var(--pc-radius);
    box-shadow: var(--pc-shadow);
    overflow: hidden;
    background: var(--hl-surface);
    border: 1px solid var(--hl-border);
  }
  .pc__shot img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .pc__copy {
    min-width: 0;
  }
  .pc__area {
    display: inline-block;
    margin: 0 0 10px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-heavy);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hl-primary);
  }
  .pc__title {
    margin: 0 0 14px;
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--hl-text-strong);
  }
  .pc__bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .pc__bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--hl-text);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .pc__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--hl-primary);
  }

  .pc__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 1.35rem;
  }
  .pc__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--hl-border);
    border-radius: var(--pc-radius);
    background: var(--hl-surface);
    color: var(--hl-primary-dark);
    cursor: pointer;
    box-shadow: var(--pc-shadow);
  }
  .pc__arrow:hover {
    border-color: var(--hl-primary);
    color: var(--hl-primary);
  }
  .pc__arrow:focus-visible {
    outline: 2px solid var(--hl-primary-soft);
    outline-offset: 2px;
  }

  .pc__dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .pc__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--hl-border);
    cursor: pointer;
  }
  .pc__dot.is-active {
    background: var(--hl-primary);
    transform: scale(1.15);
  }
  .pc__dot:focus-visible {
    outline: 2px solid var(--hl-primary-soft);
    outline-offset: 3px;
  }

  .pc__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 800px) {
    .pc__slide {
      grid-template-columns: minmax(16rem, 18.5rem) minmax(0, 1fr);
      gap: 2.25rem;
      align-items: center;
    }
    .pc__shot {
      margin: 0;
    }
    .pc__title {
      font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.55rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc__track {
      scroll-behavior: auto;
    }
    .pc__dot.is-active {
      transform: none;
    }
  }
</style>
