---
import { PRODUCT_SCREENS } from '../data/product-screens';

function screen(id: string) {
  const found = PRODUCT_SCREENS.find((item) => item.id === id);
  if (!found) throw new Error(`Print em falta: ${id}`);
  return found;
}

const shots = [
  {
    screen: screen('portal-home'),
    tag: 'Valor 01',
    title: 'Portal completo no celular do hóspede',
    copy: 'O mesmo link concentra cadastro, acompanhantes, regras, localização e instruções do imóvel. Para condomínios, o valor é chegar com dados organizados antes da portaria pedir.',
  },
  {
    screen: screen('anfitri-ia'),
    tag: 'Valor 02',
    title: 'Anfitri-IA responde e deixa rastreio',
    copy: 'No painel, pergunte em linguagem natural sobre pendências e cadastros. A resposta usa os dados da operação, e o histórico da conversa com o hóspede fica por reserva para suporte e condomínio.',
  },
  {
    screen: screen('reserva-cartao'),
    tag: 'Valor 03',
    title: 'Controle da reserva do começo ao fechamento',
    copy: 'O cartão junta bloco, datas, formulário do hóspede, cadastro no condomínio e pagamento. O anfitrião deixa de perseguir informação em conversas soltas.',
  },
  {
    screen: screen('financeiro-painel'),
    tag: 'Valor 04',
    title: 'Financeiro sem surpresa no extrato',
    copy: 'Previsão, recebido, custos e lucro por imóvel ficam no mesmo painel, com divergência de repasse sinalizada antes de fechar o mês.',
  },
  {
    screen: screen('limpeza-fotos'),
    tag: 'Valor 05',
    title: 'Faxina comprovada antes do próximo check-in',
    copy: 'A equipe trabalha com O.S. automática, registro de chegada ao imóvel e fotos de itens sorteados. O anfitrião ganha prova operacional sem precisar pedir confirmação por mensagem.',
  },
];
---

<section class="block demo-showcase" id="demo-valores">
  <div class="container demo-showcase__head">
    <span class="demo-showcase__eyebrow">Telas reais · dados de demonstração</span>
    <h2>Os prints que explicam por que o HostLogic vale para o anfitrião</h2>
    <p class="sub">
      A proposta é mostrar o produto em situações reais de operação: hóspede preenchendo o portal,
      anfitrião acompanhando a reserva, financeiro conferindo repasse e equipe comprovando faxina.
    </p>
  </div>

  <div class="container demo-stage">
    {
      shots.map((shot) => (
        <article class="demo-card">
          <div class="demo-card__shot">
            <img
              src={shot.screen.image}
              alt={shot.screen.alt}
              width={shot.screen.width}
              height={shot.screen.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="demo-card__copy">
            <span>{shot.tag}</span>
            <h3>{shot.title}</h3>
            <p>{shot.copy}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
