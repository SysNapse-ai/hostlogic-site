---
import { PRODUCT_SCREENS } from '../data/product-screens';

function screen(id: string) {
  const found = PRODUCT_SCREENS.find((item) => item.id === id);
  if (!found) throw new Error(`Print em falta: ${id}`);
  return found;
}

const shots = [
  {
    screen: screen('portal-home'),
    tag: 'Valor 01',
    title: 'Portal completo no celular do hóspede',
    copy: 'O mesmo link concentra cadastro, acompanhantes, regras, localização e instruções do imóvel. O hóspede se resolve sozinho; você acompanha no painel.',
  },
  {
    screen: screen('anfitri-ia'),
    tag: 'Valor 02',
    title: 'Anfitri-IA responde e deixa rastreio',
    copy: 'Cole o texto do anúncio como rascunho: ela organiza e só responde o que você cadastrou. No painel, pergunte por texto ou PTT sobre as estadias.',
  },
  {
    screen: screen('reserva-cartao'),
    tag: 'Valor 03',
    title: 'Controle da reserva do começo ao fechamento',
    copy: 'O cartão junta bloco, datas, cadastro do hóspede, faxina e pagamento. O anfitrião deixa de perseguir informação em conversas soltas.',
  },
  {
    screen: screen('financeiro-painel'),
    tag: 'Valor 04',
    title: 'Relatório do mês em um clique',
    copy: 'Reservas, custos e lucro por imóvel ficam no mesmo painel. O fechamento sai no botão — a operação inteira, não só o extrato da Airbnb.',
  },
  {
    screen: screen('limpeza-fotos'),
    tag: 'Valor 05',
    title: 'Faxina comprovada antes do próximo check-in',
    copy: 'A equipe trabalha com O.S. automática, senha própria, registro de chegada e fotos. Você ganha prova da limpeza e do estado do imóvel.',
  },
];
---

<section class="block demo-showcase" id="demo-valores">
  <div class="container demo-showcase__head">
    <span class="demo-showcase__eyebrow">Telas reais · dados de demonstração</span>
    <h2>Os prints que explicam por que o HostLogic vale para o anfitrião</h2>
    <p class="sub">
      A proposta é mostrar o produto em situações reais: hóspede no portal, anfitrião na reserva,
      relatório do mês e equipe comprovando a faxina.
    </p>
  </div>

  <div class="container demo-stage">
    {
      shots.map((shot) => (
        <article class="demo-card">
          <div class="demo-card__shot">
            <img
              src={shot.screen.image}
              alt={shot.screen.alt}
              width={shot.screen.width}
              height={shot.screen.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="demo-card__copy">
            <span>{shot.tag}</span>
            <h3>{shot.title}</h3>
            <p>{shot.copy}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
